# PostgreSQL connection string (Neon: https://neon.tech)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

WEBHOOK_SECRET="replace-with-strong-random-string"

# Vercel Blob — set automatically when you add a Blob store in Vercel dashboard
# For local dev: run `npx vercel env pull` after linking the project
BLOB_READ_WRITE_TOKEN=""

# Vision API for image analysis — set ONE of these:
ANTHROPIC_API_KEY="sk-ant-..."   # Claude Vision (preferred)
GEMINI_API_KEY="AIza..."         # Google Gemini (alternative)

# Lots calculation defaults (optional — override to match your account)
DEFAULT_ACCOUNT_SIZE=10000
DEFAULT_RISK_PCT=1.5
DEFAULT_LOT_MULTIPLIER=100000
